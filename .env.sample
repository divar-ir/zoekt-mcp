# Zoekt MCP Server Configuration

# Required: Zoekt API URL
ZOEKT_API_URL=https://zoekt.example.com/

# Optional: Basic Authentication (if your Zoekt instance requires auth)
# ZOEKT_API_LOGIN=your_username
# ZOEKT_API_PASSWORD=your_password

# Optional: SSL verification (default: true)
# Set to false for self-signed certificates
# ZOEKT_VERIFY_SSL=false

# Optional: Server ports
# MCP_SSE_PORT=8000
# MCP_STREAMABLE_HTTP_PORT=8080
